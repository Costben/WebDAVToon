<resources>
    <!--
      Single non-Material application theme.

      Every screen is Compose + COUI, so this theme only supplies the View host's window
      background and system-bar setup. Per-theme colors are applied by the Compose layer
      (see ui/theme/Theme.kt); there is no Material3 parent, no appcompat popup styling and
      no per-theme style per theme id.
    -->
    <style name="Base.Theme.WebDAVToon" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.WebDAVToon" parent="Base.Theme.WebDAVToon" />
</resources>
