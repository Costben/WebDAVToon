<resources>
    <!--
      Only the window background needs a dark variant: all other colors are resolved by
      the Compose/COUI layer at runtime.

      The value mirrors COUI's ColorOS 17 dark page container
      (`AppBarBlurOverlayDefaults.DarkContainerColor` -> `#303030`), which is the page
      background used by `GlassTopBarScaffold`/top bars/navigation rail. Keeping it in sync
      avoids a wrong-colored window flash before the first Compose frame.
    -->
    <color name="surface">#303030</color>
</resources>
